# Copy to server/.env. Never add this key to Flutter or Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RECRUITMENT_MODEL=gpt-5.4-mini
PORT=8787

# Password reset email (server only). Gmail example; use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional address/place search; unrelated to OpenAI.
GEOAPIFY_API_KEY=
